# Railway Postgres provides this automatically when you link the database
DATABASE_URL=postgres://postgres@localhost:5432/casavilla
# Long random string used to sign login sessions
AUTH_SECRET=change-me-to-a-long-random-string
# First CasaVilla manager account (created automatically on first start)
MANAGER_EMAIL=info.casavilla026@gmail.com
MANAGER_PASSWORD=change-me
# Public URL of the site (used for payment callbacks)
APP_URL=http://localhost:3000
# Mobile Money: "sandbox" simulates payments; "flutterwave" charges real MTN/Airtel MoMo
PAYMENT_PROVIDER=sandbox
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  tenant
  landlord
  provider
  manager
  caretaker
}

enum UserStatus {
  pending
  active
  suspended
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  phone        String
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(active)
  // service providers
  businessName String?    @map("business_name")
  bio          String?
  area         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  /// Where the person lives or is based (any level — a district is fine when the exact village is unknown).
  locationId   String?    @map("location_id")
  location     Location?  @relation(fields: [locationId], references: [id])

  files           File[]
  properties      Property[]
  applications    Application[]
  tenantLeases    Lease[]        @relation("LeaseTenant")
  landlordLeases  Lease[]        @relation("LeaseLandlord")
  payments        Payment[]      @relation("PaymentTenant")
  recordedPayments Payment[]     @relation("PaymentRecorder")
  services        Service[]
  products        Product[]
  orders          Order[]        @relation("OrderBuyer")
  sales           Order[]        @relation("OrderSeller")
  requestedJobs   Job[]          @relation("JobRequester")
  landlordJobs    Job[]          @relation("JobLandlord")
  providerJobs    Job[]          @relation("JobProvider")
  jobNotes        JobNote[]
  documents       Document[]
  notifications   Notification[]
  audits          AuditLog[]
  linkRequests    TenantLink[]   @relation("LinkTenant")
  linkInvites     TenantLink[]   @relation("LinkLandlord")
  serviceAreas    ProviderArea[]
  brand           BrandProfile?
  bookings        Booking[]      @relation("BookingGuest")
  /// Send receipts and booking confirmations by email (once an email provider is configured).
  emailReceipts   Boolean        @default(true) @map("email_receipts")
  /// When the phone number was confirmed with a WhatsApp/SMS code.
  phoneVerifiedAt DateTime?      @map("phone_verified_at")
  /// Rent reminders and notices on WhatsApp / SMS.
  messageOptIn    Boolean        @default(true) @map("message_opt_in")
  /// Landlords: send tenants automatic rent reminders.
  remindTenants   Boolean        @default(true) @map("remind_tenants")
  /// Landlords: management commission (% of rent collected) shown on monthly statements. 0 = self-managed.
  commissionPct   Float          @default(0) @map("commission_pct")
  messages        MessageOutbox[]
  caretakerOf     CaretakerAssignment[] @relation("Caretaker")
  caretakers      CaretakerAssignment[] @relation("CaretakerLandlord")
  inspections     Inspection[]   @relation("InspectionBy")
  expenses        Expense[]      @relation("ExpenseLandlord")
  expensesAdded   Expense[]      @relation("ExpenseBy")
  meterReadings   MeterReading[]
  utilityBills    UtilityBill[]
  saleListings    SaleListing[]
  saleEnquiries   SaleEnquiry[]

  @@map("users")
}

model File {
  id        Int      @id @default(autoincrement())
  ownerId   Int?     @map("owner_id")
  owner     User?    @relation(fields: [ownerId], references: [id])
  name      String
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  // documents are private; listing/product photos are public
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("files")
}

model Property {
  id          Int        @id @default(autoincrement())
  landlordId  Int        @map("landlord_id")
  landlord    User       @relation(fields: [landlordId], references: [id])
  name        String
  type        String
  /// Readable address line (kept for existing records; filled from the structured address for new ones).
  location    String
  /// Canonical administrative location — the single source of truth for where the property is.
  locationId  String?    @map("location_id")
  place       Location?  @relation(fields: [locationId], references: [id])
  estate      String?    // estate / neighbourhood
  street      String?
  building    String?
  plot        String?
  landmark    String?
  /// Exact position, only from the user's GPS or a map pin — never a district centre.
  lat         Float?
  lng         Float?
  coordAccuracyM Int?    @map("coord_accuracy_m")
  coordSource String?    @map("coord_source") // gps | map
  description String?
  /// Removed by the landlord but kept because it has tenancy history (receipts, statements). Hidden everywhere.
  archivedAt  DateTime?  @map("archived_at")
  photos      PropertyPhoto[]
  photoId     Int?       @map("photo_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  units       Unit[]
  jobs        Job[]
  documents   Document[]
  caretakers  CaretakerAssignment[]
  expenses    Expense[]
  meters      Meter[]

  @@index([landlordId])
  @@index([locationId])
  @@map("properties")
}

model Unit {
  id           Int           @id @default(autoincrement())
  propertyId   Int           @map("property_id")
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label        String
  bedrooms     Int           @default(1)
  rent         Int // UGX per month
  status       String        @default("vacant") // vacant | occupied
  listed       Boolean       @default(true)
  bathrooms    Int           @default(1)
  selfContained Boolean      @default(true) @map("self_contained")
  furnished    Boolean       @default(false)
  sizeSqm      Int?          @map("size_sqm")
  amenities    String[]      @default([])
  /// long = monthly tenancy; short = nightly stays (Airbnb-style)
  mode         String        @default("long")
  nightlyRate  Int?          @map("nightly_rate")
  cleaningFee  Int           @default(0) @map("cleaning_fee")
  minNights    Int           @default(1) @map("min_nights")
  maxGuests    Int           @default(2) @map("max_guests")
  checkInFrom  String        @default("14:00") @map("check_in_from")
  checkOutBy   String        @default("10:00") @map("check_out_by")
  houseRules   String?       @map("house_rules")
  photos       PropertyPhoto[]
  bookings     Booking[]
  applications Application[]
  leases       Lease[]
  jobs         Job[]
  inspections  Inspection[]
  expenses     Expense[]
  meters       Meter[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([propertyId])
  @@map("units")
}

model Application {
  id        Int       @id @default(autoincrement())
  unitId    Int       @map("unit_id")
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId  Int       @map("tenant_id")
  tenant    User      @relation(fields: [tenantId], references: [id])
  message   String?
  moveIn    DateTime? @map("move_in") @db.Date
  status    String    @default("pending") // pending | approved | rejected | withdrawn
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([unitId])
  @@index([tenantId])
  @@map("applications")
}

model Lease {
  id         Int        @id @default(autoincrement())
  unitId     Int        @map("unit_id")
  unit       Unit       @relation(fields: [unitId], references: [id])
  tenantId   Int        @map("tenant_id")
  tenant     User       @relation("LeaseTenant", fields: [tenantId], references: [id])
  landlordId Int        @map("landlord_id")
  landlord   User       @relation("LeaseLandlord", fields: [landlordId], references: [id])
  startDate  DateTime   @map("start_date") @db.Date
  endDate    DateTime   @map("end_date") @db.Date
  rent       Int
  deposit    Int        @default(0)
  dueDay     Int        @default(5) @map("due_day")
  status     String     @default("active") // active | ended
  /// Money paid beyond what was owed; applied automatically to the next charges.
  credit     Int        @default(0)
  /// Optional late fee (% of the month's rent) added once a rent charge is 7+ days overdue. 0 = off.
  lateFeePct Int        @default(0) @map("late_fee_pct")
  endedAt    DateTime?  @map("ended_at") @db.Date
  /// Move-out settlement: positive = refund owed to the tenant, negative = tenant still owes.
  settlement Int?
  /// A rent change agreed at renewal and when it takes effect (the Act needs 60 days' notice, at most yearly).
  nextRent     Int?       @map("next_rent")
  nextRentFrom DateTime?  @map("next_rent_from") @db.Date
  /// Extra clauses agreed between landlord and tenant, printed in the tenancy agreement.
  specialTerms String?    @map("special_terms")
  createdAt  DateTime   @default(now()) @map("created_at")
  charges    Charge[]
  payments   Payment[]
  documents  Document[]
  links      TenantLink[]
  inspections Inspection[]

  @@index([tenantId])
  @@index([landlordId])
  @@map("leases")
}

model Charge {
  id          Int       @id @default(autoincrement())
  leaseId     Int       @map("lease_id")
  lease       Lease     @relation(fields: [leaseId], references: [id])
  period      String // YYYY-MM, DEPOSIT, LATE-YYYY-MM or X-<id> for one-off charges
  kind        String    @default("rent") // rent | deposit | late_fee | utility | repair | other
  description String
  /// Amount due after any waiver.
  amount      Int
  paid        Int       @default(0)
  /// How much was written off by the landlord/manager.
  waived      Int       @default(0)
  dueDate     DateTime  @map("due_date") @db.Date
  status      String    @default("unpaid") // unpaid | partial | paid
  createdAt   DateTime  @default(now()) @map("created_at")
  payments    Payment[]
  allocations Allocation[]

  @@unique([leaseId, period])
  @@index([status, dueDate])
  @@map("charges")
}

model Payment {
  id           Int       @id @default(autoincrement())
  chargeId     Int       @map("charge_id")
  charge       Charge    @relation(fields: [chargeId], references: [id])
  leaseId      Int       @map("lease_id")
  lease        Lease     @relation(fields: [leaseId], references: [id])
  tenantId     Int       @map("tenant_id")
  tenant       User      @relation("PaymentTenant", fields: [tenantId], references: [id])
  amount       Int
  method       String // mtn | airtel | cash | bank
  phone        String?
  reference    String    @unique
  status       String    @default("pending") // pending | success | failed
  receiptNo    String?   @map("receipt_no")
  recordedById Int?      @map("recorded_by_id")
  recordedBy   User?     @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  paidAt       DateTime? @map("paid_at")
  allocations  Allocation[]

  @@index([leaseId])
  @@index([chargeId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Where money went: each successful payment (or lease credit / held deposit) is split across charges, oldest first.
model Allocation {
  id        Int      @id @default(autoincrement())
  paymentId Int?     @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id])
  chargeId  Int      @map("charge_id")
  charge    Charge   @relation(fields: [chargeId], references: [id])
  amount    Int
  source    String   @default("payment") // payment | credit | deposit
  createdAt DateTime @default(now()) @map("created_at")

  @@index([chargeId])
  @@index([paymentId])
  @@map("allocations")
}

model Service {
  id          Int     @id @default(autoincrement())
  providerId  Int     @map("provider_id")
  provider    User    @relation(fields: [providerId], references: [id])
  category    String
  title       String
  description String?
  priceFrom   Int?    @map("price_from")
  active      Boolean @default(true)
  jobs        Job[]

  @@map("services")
}

model Product {
  id          Int     @id @default(autoincrement())
  providerId  Int     @map("provider_id")
  provider    User    @relation(fields: [providerId], references: [id])
  name        String
  description String?
  price       Int
  stock       Int     @default(0)
  photoId     Int?    @map("photo_id")
  active      Boolean @default(true)
  orders      Order[]

  @@map("products")
}

model Order {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  buyerId      Int      @map("buyer_id")
  buyer        User     @relation("OrderBuyer", fields: [buyerId], references: [id])
  providerId   Int      @map("provider_id")
  provider     User     @relation("OrderSeller", fields: [providerId], references: [id])
  quantity     Int
  total        Int
  deliveryNote String?  @map("delivery_note")
  status       String   @default("placed") // placed | confirmed | delivered | cancelled
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([providerId])
  @@index([buyerId])
  @@map("orders")
}

/// Maintenance requests and direct service bookings
model Job {
  id          Int       @id @default(autoincrement())
  requesterId Int       @map("requester_id")
  requester   User      @relation("JobRequester", fields: [requesterId], references: [id])
  propertyId  Int?      @map("property_id")
  property    Property? @relation(fields: [propertyId], references: [id])
  unitId      Int?      @map("unit_id")
  unit        Unit?     @relation(fields: [unitId], references: [id])
  landlordId  Int?      @map("landlord_id")
  landlord    User?     @relation("JobLandlord", fields: [landlordId], references: [id])
  providerId  Int?      @map("provider_id")
  provider    User?     @relation("JobProvider", fields: [providerId], references: [id])
  serviceId   Int?      @map("service_id")
  service     Service?  @relation(fields: [serviceId], references: [id])
  /// Copied from the property (or the requester) when the job is created.
  locationId  String?   @map("location_id")
  location    Location? @relation(fields: [locationId], references: [id])
  category    String
  title       String
  description String
  priority    String    @default("normal") // low | normal | urgent
  photoId     Int?      @map("photo_id")
  quote       Int?
  status      String    @default("open") // open | assigned | quoted | accepted | in_progress | done | cancelled
  assignedAt  DateTime? @map("assigned_at")
  completedAt DateTime? @map("completed_at")
  /// 1–5 stars from whoever requested/pays for the job, after it is done.
  rating      Int?
  review      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  notes       JobNote[]
  expense     Expense?

  @@index([providerId])
  @@index([landlordId])
  @@index([requesterId])
  @@index([status])
  @@index([locationId])
  @@map("jobs")
}

model JobNote {
  id        Int      @id @default(autoincrement())
  jobId     Int      @map("job_id")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  Int      @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  /// Automatic timeline entries (status changes) rather than a person's message.
  system    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([jobId])
  @@map("job_notes")
}

model Document {
  id           Int       @id @default(autoincrement())
  fileId       Int       @map("file_id")
  title        String
  leaseId      Int?      @map("lease_id")
  lease        Lease?    @relation(fields: [leaseId], references: [id])
  propertyId   Int?      @map("property_id")
  property     Property? @relation(fields: [propertyId], references: [id])
  uploadedById Int       @map("uploaded_by_id")
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  /// upload | agreement (auto-drafted tenancy agreement)
  kind         String    @default("upload")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("documents")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String?
  read      Boolean  @default(false)
  /// Set for automatic reminders so the same reminder is never sent twice.
  key       String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@map("notifications")
}

/// An existing tenant asking to be connected to their landlord (found by the landlord's phone number).
/// If the landlord isn't on CasaVilla yet, the request waits and attaches itself when they sign up.
model TenantLink {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  tenant        User      @relation("LinkTenant", fields: [tenantId], references: [id])
  landlordId    Int?      @map("landlord_id")
  landlord      User?     @relation("LinkLandlord", fields: [landlordId], references: [id])
  landlordPhone String    @map("landlord_phone")
  /// What the tenant says they rent, e.g. "Rubaga Court, Apt A2".
  unitNote      String?   @map("unit_note")
  status        String    @default("pending") // pending | linked | declined | cancelled
  leaseId       Int?      @map("lease_id")
  lease         Lease?    @relation(fields: [leaseId], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  decidedAt     DateTime? @map("decided_at")

  @@index([landlordId, status])
  @@index([landlordPhone, status])
  @@index([tenantId])
  @@map("tenant_links")
}

/// Who did what, for accountability and dispute resolution.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Run-once markers for background housekeeping (e.g. "sweep:2026-10-09T13").
model Marker {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("markers")
}

/// Uganda's administrative geography (country → region → district → county → sub-county → parish → village).
/// Imported from a versioned dataset; never edited by hand.
model Location {
  id             String          @id
  parentId       String?         @map("parent_id")
  parent         Location?       @relation("LocationTree", fields: [parentId], references: [id])
  children       Location[]      @relation("LocationTree")
  level          String // country | region | district | county | subcounty | parish | village
  kind           String // display type: District, City, Municipality, City division, County, Town council, Division, Sub-county, Parish, Ward, Village, Cell
  name           String
  /// Normalised name + aliases, for search.
  searchKey      String          @map("search_key")
  /// Every ancestor's id and its own, e.g. "/UG/UG-C/UG-D80/UG-CT203/" — descendant queries are a prefix match.
  path           String
  depth          Int
  lat            Float?
  lng            Float?
  coordAccuracyM Int?            @map("coord_accuracy_m")
  datasetVersion String          @map("dataset_version")
  aliases        LocationAlias[]
  properties     Property[]
  users          User[]
  jobs           Job[]
  providerAreas  ProviderArea[]
  saleListings   SaleListing[]

  @@index([parentId])
  @@index([level])
  @@map("locations")
}

model LocationAlias {
  id         Int      @id @default(autoincrement())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  alias      String
  aliasKey   String   @map("alias_key")

  @@unique([locationId, aliasKey])
  @@index([aliasKey])
  @@map("location_aliases")
}

/// Which dataset version is loaded, where it came from and when.
model LocationDataset {
  id            String   @id
  version       String
  checksum      String
  source        String
  licence       String
  sourceUpdated String   @map("source_updated")
  counts        Json
  importedAt    DateTime @default(now()) @map("imported_at")

  @@map("location_datasets")
}

/// The areas a service provider covers (any level; a district covers everything inside it).
model ProviderArea {
  providerId Int      @map("provider_id")
  provider   User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  @@id([providerId, locationId])
  @@index([locationId])
  @@map("provider_areas")
}

/// How receipts, agreements and booking confirmations look for one landlord (ownerId) — or CasaVilla's
/// default when ownerId is null.
model BrandProfile {
  id             Int     @id @default(autoincrement())
  ownerId        Int?    @unique @map("owner_id")
  owner          User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  displayName    String  @map("display_name")
  address        String?
  phone          String?
  email          String?
  tin            String?
  accentColor    String  @default("#124331") @map("accent_color")
  footerNote     String? @map("footer_note")
  signatory      String?
  signatoryTitle String? @map("signatory_title")
  showCasaVilla  Boolean @default(true) @map("show_casavilla")
  logoFileId     Int?    @map("logo_file_id")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("brand_profiles")
}

/// Listing photos, taken through the guided shot list.
model PropertyPhoto {
  id         Int      @id @default(autoincrement())
  propertyId Int      @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     Int?     @map("unit_id")
  unit       Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fileId     Int      @map("file_id")
  /// exterior | compound | living | kitchen | bedroom | bathroom | dining | balcony | view | other
  room       String
  label      String
  sort       Int      @default(0)
  isCover    Boolean  @default(false) @map("is_cover")
  width      Int?
  height     Int?
  /// 0–100 from the on-device checks (light, sharpness, orientation, size).
  quality    Int?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([unitId])
  @@map("property_photos")
}

/// A short stay in a short-stay unit. Dates are nights [checkIn, checkOut). Overlaps are refused by the database.
model Booking {
  id          Int       @id @default(autoincrement())
  unitId      Int       @map("unit_id")
  unit        Unit      @relation(fields: [unitId], references: [id])
  guestId     Int       @map("guest_id")
  guest       User      @relation("BookingGuest", fields: [guestId], references: [id])
  checkIn     DateTime  @map("check_in") @db.Date
  checkOut    DateTime  @map("check_out") @db.Date
  nights      Int
  guests      Int       @default(1)
  nightly     Int
  cleaningFee Int       @default(0) @map("cleaning_fee")
  total       Int
  /// pending (held while paying) | confirmed | cancelled | completed | expired | blocked (host's own dates)
  status      String    @default("pending")
  reference   String    @unique
  method      String?
  phone       String?
  receiptNo   String?   @map("receipt_no")
  paidAt      DateTime? @map("paid_at")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([unitId, checkIn])
  @@index([guestId])
  @@index([status])
  @@map("bookings")
}

/// Emails waiting to go out. Sent by housekeeping once an email provider is configured; until then they wait.
model EmailOutbox {
  id        Int       @id @default(autoincrement())
  toEmail   String    @map("to_email")
  subject   String
  html      String
  /// receipt | booking — attaches that document as a PDF when sending
  attachKind String?  @map("attach_kind")
  attachId  Int?      @map("attach_id")
  status    String    @default("queued") // queued | sent | failed
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@map("email_outbox")
}

/// WhatsApp / SMS messages. Codes are sent straight away; reminders wait here and go out in daytime.
model MessageOutbox {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  toPhone     String    @map("to_phone")
  /// otp | reminder | notice
  kind        String
  /// WhatsApp template name and its {{1}}, {{2}}… values; text is the same message for SMS.
  template    String?
  params      String[]  @default([])
  text        String
  /// Stops the same reminder going twice (e.g. "rent-due0:42").
  dedupeKey   String?   @unique @map("dedupe_key")
  /// queued | sent | failed | expired | test (no provider set up — shown on System health)
  status      String    @default("queued")
  channel     String?   // whatsapp | sms
  providerRef String?   @map("provider_ref")
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("message_outbox")
}

/// One-time codes for confirming a phone number (sign-up) or resetting a password. Only a hash is stored.
model PhoneCode {
  id         Int       @id @default(autoincrement())
  phone      String
  purpose    String // signup | reset
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@map("phone_codes")
}

/// A caretaker looking after one of a landlord's properties.
model CaretakerAssignment {
  id             Int      @id @default(autoincrement())
  caretakerId    Int      @map("caretaker_id")
  caretaker      User     @relation("Caretaker", fields: [caretakerId], references: [id], onDelete: Cascade)
  landlordId     Int      @map("landlord_id")
  landlord       User     @relation("CaretakerLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  propertyId     Int      @map("property_id")
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// May record cash rent collected on site.
  canCollect     Boolean  @default(true) @map("can_collect")
  /// May see what each tenant owes (to follow up on arrears).
  canSeeBalances Boolean  @default(true) @map("can_see_balances")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([caretakerId, propertyId])
  @@index([propertyId])
  @@map("caretaker_assignments")
}

/// Condition report: at move-in, at move-out (compared with move-in), or a routine check.
model Inspection {
  id             Int       @id @default(autoincrement())
  unitId         Int       @map("unit_id")
  unit           Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  leaseId        Int?      @map("lease_id")
  lease          Lease?    @relation(fields: [leaseId], references: [id])
  kind           String // move_in | move_out | routine
  /// draft (being filled in) | submitted (waiting for the tenant) | agreed | disputed
  status         String    @default("draft")
  conductedById  Int       @map("conducted_by_id")
  conductedBy    User      @relation("InspectionBy", fields: [conductedById], references: [id])
  conductedOn    DateTime  @default(now()) @map("conducted_on") @db.Date
  keys           Int?
  notes          String?
  submittedAt    DateTime? @map("submitted_at")
  tenantAnsweredAt DateTime? @map("tenant_answered_at")
  tenantComment  String?   @map("tenant_comment")
  /// Move-out: total deductions for damage, and the charge they were billed as.
  deductions     Int       @default(0)
  chargeId       Int?      @unique @map("charge_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  items          InspectionItem[]
  readings       MeterReading[]

  @@index([unitId])
  @@index([leaseId])
  @@map("inspections")
}

model InspectionItem {
  id           Int        @id @default(autoincrement())
  inspectionId Int        @map("inspection_id")
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  area         String
  item         String
  sort         Int        @default(0)
  /// good | fair | poor | damaged | missing | na
  condition    String     @default("good")
  note         String?
  photoIds     Int[]      @default([]) @map("photo_ids")
  /// Move-out only: amount to take from the deposit for this item.
  deduction    Int        @default(0)

  @@index([inspectionId])
  @@map("inspection_items")
}

/// Money a landlord spent on a property (repairs, security, garbage, commission, …), for monthly statements.
model Expense {
  id            Int       @id @default(autoincrement())
  landlordId    Int       @map("landlord_id")
  landlord      User      @relation("ExpenseLandlord", fields: [landlordId], references: [id])
  propertyId    Int?      @map("property_id")
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId        Int?      @map("unit_id")
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category      String
  description   String
  amount        Int
  spentOn       DateTime  @map("spent_on") @db.Date
  receiptFileId Int?      @map("receipt_file_id")
  /// Repairs paid through CasaVilla are added automatically from the finished job.
  jobId         Int?      @unique @map("job_id")
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Caretakers' expenses wait for the landlord: pending | approved | rejected
  status        String    @default("approved")
  createdById   Int       @map("created_by_id")
  createdBy     User      @relation("ExpenseBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([landlordId, spentOn])
  @@index([propertyId])
  @@map("expenses")
}

/// An electricity (Yaka) or water (NWSC) meter — for one unit, or shared by the property.
model Meter {
  id         Int      @id @default(autoincrement())
  propertyId Int      @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// The unit it serves; empty = shared by the whole property (or the units listed in shareUnitIds).
  unitId     Int?     @map("unit_id")
  unit       Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind       String // electricity | water
  label      String?
  number     String?
  /// prepaid: tenant buys tokens / pays the utility directly (readings for records only)
  /// submeter: landlord bills the tenant from readings × rate
  /// shared: landlord enters the monthly bill and it is split between the units
  billing    String   @default("prepaid")
  /// UGX per unit (kWh or m³) for sub-meters.
  rate       Int?
  /// Shared meters: which units share the bill (empty = every occupied unit in the property).
  shareUnitIds Int[]  @default([]) @map("share_unit_ids")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  readings   MeterReading[]
  bills      UtilityBill[]

  @@index([propertyId])
  @@index([unitId])
  @@map("meters")
}

model MeterReading {
  id           Int         @id @default(autoincrement())
  meterId      Int         @map("meter_id")
  meter        Meter       @relation(fields: [meterId], references: [id], onDelete: Cascade)
  reading      Float
  readOn       DateTime    @map("read_on") @db.Date
  photoFileId  Int?        @map("photo_file_id")
  recordedById Int         @map("recorded_by_id")
  recordedBy   User        @relation(fields: [recordedById], references: [id])
  inspectionId Int?        @map("inspection_id")
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  /// Sub-meters: the tenant charge raised from this reading.
  chargeId     Int?        @unique @map("charge_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([meterId, readOn])
  @@map("meter_readings")
}

/// A shared meter's bill for one month, split into charges on each sharing unit's lease.
model UtilityBill {
  id          Int      @id @default(autoincrement())
  meterId     Int      @map("meter_id")
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  period      String // YYYY-MM
  amount      Int
  note        String?
  splitCount  Int      @default(0) @map("split_count")
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([meterId, period])
  @@map("utility_bills")
}

/// Land or property for sale. Separate from rentals: land has no units, tenants or rent.
/// Landlords' listings are reviewed by CasaVilla before they go public.
model SaleListing {
  id             Int        @id @default(autoincrement())
  ownerId        Int        @map("owner_id")
  owner          User       @relation(fields: [ownerId], references: [id])
  /// land | house | apartment | commercial | farm
  kind           String
  title          String
  description    String?
  /// Asking price in UGX (double precision: land prices can pass 2 billion).
  price          Float
  negotiable     Boolean    @default(true)
  /// Land size: value + unit (acres | decimals | hectares | sqm); plotDims for e.g. "50 × 100 ft".
  sizeValue      Float?     @map("size_value")
  sizeUnit       String?    @map("size_unit")
  plotDims       String?    @map("plot_dims")
  bedrooms       Int?
  bathrooms      Int?
  /// mailo | freehold | leasehold | customary | kibanja
  tenure         String?
  /// titled | processing | none
  titleStatus    String     @default("titled") @map("title_status")
  /// CasaVilla has seen the title and done a land search.
  titleVerified  Boolean    @default(false) @map("title_verified")
  features       String[]   @default([])
  location       String
  locationId     String?    @map("location_id")
  place          Location?  @relation(fields: [locationId], references: [id])
  estate         String?
  street         String?
  plot           String?
  landmark       String?
  lat            Float?
  lng            Float?
  coordAccuracyM Int?       @map("coord_accuracy_m")
  coordSource    String?    @map("coord_source")
  /// pending (waiting for CasaVilla) | active | under_offer | sold | withdrawn | rejected
  status         String     @default("pending")
  reviewNote     String?    @map("review_note")
  photoId        Int?       @map("photo_id")
  views          Int        @default(0)
  publishedAt    DateTime?  @map("published_at")
  soldAt         DateTime?  @map("sold_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")
  photos         SalePhoto[]
  enquiries      SaleEnquiry[]

  @@index([status, kind])
  @@index([ownerId])
  @@index([locationId])
  @@map("sale_listings")
}

model SalePhoto {
  id        Int         @id @default(autoincrement())
  listingId Int         @map("listing_id")
  listing   SaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fileId    Int         @map("file_id")
  sort      Int         @default(0)
  isCover   Boolean     @default(false) @map("is_cover")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([listingId])
  @@map("sale_photos")
}

/// A buyer's question or viewing request. Guests can send one with a name and phone number.
model SaleEnquiry {
  id           Int         @id @default(autoincrement())
  listingId    Int         @map("listing_id")
  listing      SaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId       Int?        @map("user_id")
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  phone        String
  message      String?
  wantsViewing Boolean     @default(false) @map("wants_viewing")
  viewingDate  DateTime?   @map("viewing_date") @db.Date
  /// new | contacted | closed
  status       String      @default("new")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([listingId, status])
  @@index([phone, createdAt])
  @@map("sale_enquiries")
}
